%% A session's line to the SSH domain (docs/design-ssh.md, "Sessions, ttys and
%% shells"): erx_ssh_line, its pure core erx_ssh_line_core, the job relay erx_ssh_job
%% with its core erx_ssh_job_core, and the application that
%% names it. The session's boot script starts it, permanent, before init's ready
%% report, which names the line.
{application, erx_ssh_line,
 [{description, "erXos session's line to the SSH domain"},
  {vsn, "1"},
  {modules, [erx_ssh_job, erx_ssh_job_core, erx_ssh_line, erx_ssh_line_app, erx_ssh_line_core]},
  {registered, []},
  {applications, [kernel, stdlib, erx, erx_shell]},
  {mod, {erx_ssh_line_app, []}},
  {env, []}]}.
