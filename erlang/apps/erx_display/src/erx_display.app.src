%% The display domain's side of the window system (docs/design-display.md,
%% "Overview"): the display driver behaviour erx_display, which the
%% display drivers of erx_fb implement; the screen, erx_screen over its pure
%% core erx_screen_core, which decides what it fills, copies and
%% pushes, and which erx_fb_sup starts behind the driver; the window policy
%% behaviour erx_wm with erx_wm_single and erx_wm_rio; the window system erx_winfs, the mint and
%% tree of the windows service, which erx_fb_sup starts first, with erx_input, its
%% input router's pure core, erx_input_reader, the router's source of an input file
%% another domain serves, and erx_window, one
%% process for each window; and erx_wctl and erx_winctl, the text of a window's wctl
%% and ctl files; and erx_keymap, the keyboard layouts generated from abi/keymaps/.
%% A library application: it starts no process of its own, and
%% none of its modules decodes a client's draw, picture, font or widget bytes
%% (G9).
{application, erx_display,
 [{description, "erXos display services"},
  {vsn, "1"},
  {modules, [erx_display, erx_input, erx_input_reader, erx_keymap, erx_screen, erx_screen_core, erx_splash, erx_splash_mark, erx_wctl, erx_window, erx_winctl,
              erx_winfs, erx_wm, erx_wm_rio, erx_wm_single]},
  {registered, []},
  {applications, [kernel, stdlib, erx, erx_files, erx_memdraw]},
  {env, []}]}.
