%% A session's domain (docs/design-live.md, "Sessions"): the session's ttys,
%% erx_session_tty, on which the command shell runs, and the pure core of the tty's
%% side of the messages to its master, erx_tty_link, and of its line discipline,
%% erx_tty; the fixed tree of the session's
%% export, erx_session_export (docs/design-files.md, "Narrowing for a program"); and
%% erx_ssh_dev, which starts OTP's ssh daemon in a development session
%% (docs/design-ssh.md, "Stages").
%%
%% Its applications are those that must run before it starts. ssh, with
%% public_key, is not one: erx_ssh_dev starts it when it starts the daemon, so a
%% session that starts none runs no ssh supervisor.
{application, erx_session,
 [{description, "erXos session"},
  {vsn, "1"},
  {modules, [erx_session_app, erx_session_export, erx_session_relay_core, erx_session_sup, erx_session_tty, erx_ssh_dev,
              erx_tty, erx_tty_link, erx_tty_modes]},
  {registered, [erx_session_sup]},
  {applications, [kernel, stdlib, erx, erx_files, erx_shell]},
  {mod, {erx_session_app, []}},
  {env, []}]}.
