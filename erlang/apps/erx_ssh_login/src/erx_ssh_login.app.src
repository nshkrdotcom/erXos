%% The SSH login facet (docs/design-ssh.md, "Logging in"): erx_ssh_wire, the
%% decoder of what the SSH domain hands the system domain at a login. It runs in
%% the system domain only, whose release alone ships it.
{application, erx_ssh_login,
 [{description, "erXos SSH login facet"},
  {vsn, "1"},
  {modules, [erx_ssh_wire]},
  {registered, []},
  {applications, [kernel, stdlib, erx]}]}.
