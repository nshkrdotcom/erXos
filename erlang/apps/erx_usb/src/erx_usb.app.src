%% The USB stack (docs/design-usb.md). Its pure cores build and are tested on the host:
%% erx_hid_desc, the HID report descriptor's parser, and erx_hid_core, the fold of reports into input records.
{application, erx_usb,
 [{description, "erXos USB stack"},
  {vsn, "1"},
  {modules, [erx_hid_core, erx_hid_desc]},
  {registered, []},
  {applications, [kernel, stdlib, erx]},
  {env, []}]}.
