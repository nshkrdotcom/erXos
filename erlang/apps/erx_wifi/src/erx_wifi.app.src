%% erXos's WiFi (docs/design-wifi.md): the WiFi domain's chip, station and
%% supplicant. Its modules are pure cores: the station's choice, join machine and failure
%% memory, erx_wifi_choose, erx_wifi_join and erx_wifi_memory, the key holder's requests,
%% erx_wifi_keys, SAE's erx_sae, and the supplicant's erx_wpa_kdf, the
%% key arithmetic over OTP's crypto, and erx_wpa_key, the EAPOL-Key codec; they
%% start no process.
{application, erx_wifi,
 [{description, "erXos WiFi"},
  {vsn, "1"},
  {modules, [erx_sae, erx_wifi_choose, erx_wifi_join, erx_wifi_keys, erx_wifi_memory, erx_wpa_kdf,
             erx_wpa_key]},
  {registered, []},
  {applications, [kernel, stdlib, crypto, erx]},
  {env, []}]}.
