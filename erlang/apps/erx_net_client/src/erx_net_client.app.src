%% The client side of the network stack (docs/design-network-stack.md, "Modules"): the
%% socket backends every domain, and a node outside erXos beside erx_net, runs. Its one
%% call into the stack is its `grant` key's, an {M, F, A} that answers {ok, Grant, Origin},
%% and its one process erx_inet's resolver loader. The key has no default: the startup of
%% a domain granted the network sets it, and without it every socket call answers
%% {error, eacces} and no loader runs.
{application, erx_net_client,
 [{description, "erXos socket backends"},
  {vsn, "1"},
  {modules, [erx_gen_icmp, erx_gen_tcp, erx_gen_tcp_core, erx_gen_udp, erx_gen_udp_core, erx_host_name, erx_inet, erx_net_client_app, erx_net_client_sup, erx_net_packet, erx_sock_admit]},
  {registered, [erx_inet, erx_net_client_sup]},
  {applications, [kernel, stdlib]},
  {mod, {erx_net_client_app, []}}]}.
