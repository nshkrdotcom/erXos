%% An app's session (docs/design-packaging.md, "Starting an app"): erx_app mounts the
%% app's package at /app from the record the ready answer brings and starts what the
%% package declares. The domain release's app script only loads it; the app template's
%% -eval starts it, permanent, once the domain holds its facets.
%% Its applications are those that must run before it starts: erx_session, the
%% session's supervisor, under which the design places the command server that a
%% native app's program starts through (docs/design-packaging.md, "Starting an app"),
%% so no release holds erx_app without erx_session and no session starts it first.
%% The template's -eval therefore starts erx_session, permanent, before it.
{application, erx_app,
 [{description, "erXos app session"},
  {vsn, "1"},
  {modules, [erx_app]},
  {registered, []},
  {applications, [kernel, stdlib, erx, erx_files, erx_session]},
  {mod, {erx_app, []}},
  {env, []}]}.
