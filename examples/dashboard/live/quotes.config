%%
%% The full kiosk's source table (docs/design-quotes.md, "The source
%% table"), which its package carries as share/quotes.config. Each quote
%% asks its sources in order. The S&P 500 rows are the development
%% example's choice of the design's open decision 1, Cboe first and FRED
%% as its fallback, each named by its credit and note; whether any of
%% these sources allows public display is unverified (open decisions 1
%% and 2).

{quote, btc, #{label => <<"Bitcoin">>, decimals => 2, period => 10,
               sources => [kraken_btc, coinbase_btc]}}.
{quote, eth, #{label => <<"Ether">>, decimals => 2, period => 10,
               sources => [kraken_eth, coinbase_eth]}}.
{quote, spx, #{label => <<"S&P 500">>, decimals => 2, period => 60,
               sources => [cboe_spx, fred_spx]}}.

{source, kraken_btc,
 #{url => <<"https://api.kraken.com/0/public/Ticker?pair=XBTUSD">>,
   format => json,
   price => [<<"result">>, <<"XXBTZUSD">>, <<"c">>, 0],
   change => {from, [<<"result">>, <<"XXBTZUSD">>, <<"o">>]},
   credit => <<"Kraken">>, note => <<"change since 00:00 UTC">>}}.
{source, coinbase_btc,
 #{url => <<"https://api.exchange.coinbase.com/products/BTC-USD/ticker">>,
   format => json, price => [<<"price">>], change => none,
   credit => <<"Coinbase">>}}.
{source, kraken_eth,
 #{url => <<"https://api.kraken.com/0/public/Ticker?pair=ETHUSD">>,
   format => json,
   price => [<<"result">>, <<"XETHZUSD">>, <<"c">>, 0],
   change => {from, [<<"result">>, <<"XETHZUSD">>, <<"o">>]},
   credit => <<"Kraken">>, note => <<"change since 00:00 UTC">>}}.
{source, coinbase_eth,
 #{url => <<"https://api.exchange.coinbase.com/products/ETH-USD/ticker">>,
   format => json, price => [<<"price">>], change => none,
   credit => <<"Coinbase">>}}.
{source, cboe_spx,
 #{url => <<"https://cdn.cboe.com/api/global/delayed_quotes/quotes/_SPX.json">>,
   format => json, price => [<<"data">>, <<"current_price">>],
   change => {percent, [<<"data">>, <<"price_change_percent">>]},
   credit => <<"Cboe">>, note => <<"delayed">>}}.
{source, fred_spx,
 #{url => <<"https://fred.stlouisfed.org/graph/fredgraph.csv?id=SP500">>,
   format => {csv, 2}, change => none,
   credit => <<"FRED">>, note => <<"daily close">>}}.
