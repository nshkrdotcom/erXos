        <register>
          <name>PUP_PDN3</name><ownedByNif>false</ownedByNif>
          <description>GPIO_PUP_PDN_CNTRL_REG3 (Table 93): the pull resistor of GPIO 48 to 57; a read gives the current pull; 3 is reserved</description>
          <addressOffset>0xf0</addressOffset><access>read-write</access>
          <fields>
            <field><dim>10</dim><dimIncrement>2</dimIncrement><dimIndex>48-57</dimIndex><name>PULL%s</name><description>PULLn is GPIO n's resistor</description><bitOffset>0</bitOffset><bitWidth>2</bitWidth><enumeratedValues derivedFrom="PULL"/></field>
