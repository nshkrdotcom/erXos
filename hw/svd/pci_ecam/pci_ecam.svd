<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026, Stanislav Sedov <stas@deglitch.com>
     SPDX-License-Identifier: BSD-2-Clause

     A PCIe host bridge's ECAM configuration window, as QEMU virt's
     pci-host-ecam-generic bridge has one (docs/design-pcie.md, "The bridge seam").
     Written by erXos from FreeBSD's ECAM host at releng/15.1, commit
     95719d8a895bf8170851e9844d9b4092b1d2b6fe: sys/dev/pci/pci_host_generic.h
     (SHA-256 6bb956a1ac2609d723c4ac0ed751ae7f50537f2371def410a8e8bba588a93b61),
     lines 37-50, and sys/dev/pci/pci_host_generic.c (SHA-256
     d89ad72f72c3ef3c218256468ef4035354e9b72185a8b50eeb22390a2fbd6034), lines
     297-334, generic_pcie_read_config.

     The window holds no register of its own: each function's 4 KiB of configuration
     space lies at (bus - first bus) << 20 | device << 15 | function << 12 of it,
     which is the function's routing ID ((bus - first) << 8 | device << 3 | function)
     times 4 KiB, so the window is one configuration space of 65536 blocks of 4 KiB,
     FUNCTION[routing ID], in erXos's configurationSpace extension
     (docs/design-generation.md, "Register inputs"). Accesses are 1, 2 or 4 bytes at an
     offset of their width inside one block (pci_host_generic.c:319-331), and a block
     that does not lie wholly inside the window the device NIF opened, a bus past the
     window, is not reached. The address block declared here is one bus's, 1 MiB, the
     least an ECAM window holds; the window the tree's reg gives is the bound.
-->
<device schemaVersion="1.3">
  <name>pci_ecam</name>
  <version>1</version>
  <description>PCIe ECAM configuration window</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>pci_ecam</name>
      <description>Configuration space of each function a host bridge reaches</description>
      <baseAddress>0x0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x100000</size>
        <usage>registers</usage>
      </addressBlock>
      <configurationSpace>
        <name>FUNCTION[%s]</name>
        <description>One function's configuration space, by its routing ID relative to the first bus</description>
        <addressOffset>0x0</addressOffset>
        <size>0x1000</size>
        <dim>65536</dim>
      </configurationSpace>
    </peripheral>
  </peripherals>
</device>
