<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026, Stanislav Sedov <stas@deglitch.com>
     SPDX-License-Identifier: BSD-2-Clause

     The BCM2711's clock manager, naming only the PWM clock's control and divisor
     (docs/design-header-io.md, "Placement: units and domains"). Written by erXos from
     Raspberry Pi Ltd's "BCM2711 ARM Peripherals" (release 4, 18 January 2022, SHA-256
     d6e16ea089a1716e80621f99a26e130a2379f0a81d945dc22e4f80dc49dcdc78), section 5.4.2
     "Register Definitions", printed pages 82 and 83, and from FreeBSD release/14.3.0's
     sys/arm/broadcom/bcm2835/bcm2835_clkman.h (SHA-256
     906eb75a041232fac3abd8fae4cd9f92a9b21152123e1eb7ea620c53c12bbbcf) and bcm2835_clkman.c
     (SHA-256 928b5b4da511c1755c894a35f23729cb5f7f701b904800b4b7afd7b8fd87d579).

     The clock manager is at 0x7e101000 (section 5.4.2). The datasheet documents only the
     general-purpose clocks there (Table 98, CM_GP0CTL at 0x70 to CM_GP2DIV at 0x84), not
     the PWM clock. The PWM clock's offsets are FreeBSD's: its control at 0xa0
     (bcm2835_clkman.h line 36, BCM_PWM_CLKSRC) and its divisor 4 bytes past it
     (bcm2835_clkman.c lines 71 to 74, W_CMCLK to R_CMDIV), in a driver that matches
     brcm,bcm2711-cprman as well as brcm,bcm2835-cprman (bcm2835_clkman.c line 52).
     Unverified: the datasheet does not state that the BCM2711's PWM clock sits at these
     offsets with the general-purpose clocks' format, Table 99's control and Table 100's
     divisor, which FreeBSD writes it in, so every field below is those tables' for
     CM_GP0CTL and CM_GP0DIV. The window ends after the divisor. Reserved bits (6 and 11
     to 23 of the control) are not described. -->
<device schemaVersion="1.3">
  <name>CPRMAN</name><version>1</version>
  <description>BCM2711 clock manager: the PWM clock's control and divisor</description>
  <addressUnitBits>8</addressUnitBits><width>32</width>
  <peripherals>
    <peripheral>
      <name>CPRMAN</name><baseAddress>0</baseAddress>
      <addressBlock><offset>0</offset><size>0xa8</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>PWMCTL</name><ownedByNif>false</ownedByNif>
          <description>The PWM clock's control, in Table 99's format (unverified for this clock): its source, enable and MASH stages; a write takes effect only with PASSWD 0x5a</description>
          <addressOffset>0xa0</addressOffset><access>read-write</access>
          <fields>
            <field><name>SRC</name><description>Clock source; 8 to 15 are GND too; not to be changed while BUSY is 1</description><bitOffset>0</bitOffset><bitWidth>4</bitWidth>
              <enumeratedValues><enumeratedValue><name>GND</name><value>0</value></enumeratedValue><enumeratedValue><name>OSCILLATOR</name><value>1</value></enumeratedValue><enumeratedValue><name>TESTDEBUG0</name><value>2</value></enumeratedValue><enumeratedValue><name>TESTDEBUG1</name><value>3</value></enumeratedValue><enumeratedValue><name>PLLA_PER</name><value>4</value></enumeratedValue><enumeratedValue><name>PLLC_PER</name><value>5</value></enumeratedValue><enumeratedValue><name>PLLD_PER</name><value>6</value></enumeratedValue><enumeratedValue><name>HDMI_AUXILIARY</name><value>7</value></enumeratedValue></enumeratedValues>
            </field>
            <field><name>ENAB</name><description>1 requests the clock to start, 0 to stop after its current cycle</description><bitOffset>4</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>KILL</name><description>1 stops and resets the clock generator, for test and debug only</description><bitOffset>5</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>BUSY</name><description>1 while the clock generator runs</description><bitOffset>7</bitOffset><bitWidth>1</bitWidth><access>read-only</access></field>
            <field><name>FLIP</name><description>1 inverts the output, for test and debug only</description><bitOffset>8</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>MASH</name><description>0 integer division, 1 to 3 that many MASH stages; not to be changed while BUSY is 1</description><bitOffset>9</bitOffset><bitWidth>2</bitWidth></field>
            <field><name>PASSWD</name><description>The clock manager's password, 0x5a, with every write</description><bitOffset>24</bitOffset><bitWidth>8</bitWidth><access>write-only</access></field>
          </fields>
        </register>
        <register>
          <name>PWMDIV</name><ownedByNif>false</ownedByNif>
          <description>The PWM clock's divisor, in Table 100's format (unverified for this clock); a write takes effect only with PASSWD 0x5a</description>
          <addressOffset>0xa4</addressOffset><access>read-write</access>
          <fields>
            <field><name>DIVF</name><description>The divisor's fractional part</description><bitOffset>0</bitOffset><bitWidth>12</bitWidth></field>
            <field><name>DIVI</name><description>The divisor's integer part, at least the minimum the MASH setting needs</description><bitOffset>12</bitOffset><bitWidth>12</bitWidth></field>
            <field><name>PASSWD</name><description>The clock manager's password, 0x5a, with every write</description><bitOffset>24</bitOffset><bitWidth>8</bitWidth><access>write-only</access></field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
