<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026, Stanislav Sedov <stas@deglitch.com>
     SPDX-License-Identifier: BSD-2-Clause

     The Arm PrimeCell Real Time Clock (PL031) as the wall-clock keeper reads it
     (docs/design-time.md, "The real-time clock at boot"), written by erXos from Arm's
     ARM PrimeCell Real Time Clock (PL031) Technical Reference Manual, revision r1p3,
     ARM DDI 0224C, as Arm's documentation service serves it
     (documentation-service.arm.com, document ddi0224 version c): section 3.2, "Summary
     of RTC registers", Table 3.1 (SHA-256 of the topic as fetched
     4a157e6bd3e17832cbd862d2806a944eb2d944ad13b6b3a362432a2137ddbe29), and section
     3.3, "Data Register, RTCDR", Table 3.2 (SHA-256
     010b9ca7afa640266ecb9889759ac624b9b508e5ded97158b6b71f16ecea97b8): RTCDR is at
     offset 0x000, read-only, 32 bits wide, and a read returns the clock's current value.

     Only RTCDR is here. erXos never writes the clock, and the match, load, control and
     interrupt registers that follow it are left out, so no driver can reach them through
     erx_device's table. Every access is an aligned 32-bit word. -->
<device schemaVersion="1.3">
  <name>PL031</name><version>1</version>
  <description>Arm PrimeCell Real Time Clock (PL031), its data register</description>
  <addressUnitBits>8</addressUnitBits><width>32</width>
  <peripherals>
    <peripheral>
      <name>PL031</name><baseAddress>0</baseAddress>
      <addressBlock><offset>0</offset><size>0x4</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>DR</name><ownedByNif>false</ownedByNif>
          <description>RTCDR: the clock's current value</description>
          <addressOffset>0x000</addressOffset><access>read-only</access>
          <fields>
            <field>
              <name>COUNT</name><description>The clock's count; QEMU virt counts seconds since 1970 (unverified against a source)</description>
              <bitOffset>0</bitOffset><bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
